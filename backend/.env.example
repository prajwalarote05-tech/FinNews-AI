# ===================================================================
# FinNews AI - Environment Configuration Template
# ===================================================================
# Copy this file to .env in this folder (or the root project folder)
# and replace placeholder values with your actual API keys.
# NEVER commit your actual .env file with secrets to Git!
# ===================================================================

# NewsAPI Key: Get yours for free at https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Groq API Key: Get yours for free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name: Configurable LLM model
# Recommended default: llama-3.3-70b-versatile
# Alternative options: llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile
